{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block navigation %}{% endblock %}

{% block body %}
<main class="home-page">
    <section class="home-panel home-panel-about d-flex align-items-center">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 col-lg-7 mb-5 mb-lg-0">
                    <h2 class="display-4 font-weight-bold mb-4">Je me présente</h2>
                    <p class="lead mb-4">
                        Je m'appelle Matthieu, j'ai 24 ans et je suis passionné par le développement web depuis plusieurs années. Depuis le 15 avril 2026, j'ai créé ma micro-entreprise afin de proposer mes services aux particuliers comme aux entreprises.
                    </p>
                    <p class="mb-4">
                        J'aime construire des sites lisibles, bien structurés et agréables à faire évoluer. Mon approche reste simple : comprendre le besoin, proposer quelque chose de juste et avancer avec clarté.
                    </p>
                    <a class="home-plus-link mt-3 d-inline-flex align-items-center" href="{{ path('app_about') }}">
                        <span>Plus d'info</span>
                        <span class="home-plus-arrow" aria-hidden="true"></span>
                    </a>
                </div>

                <div class="col-12 col-lg-5 text-center">
                    <div class="home-photo-shell mx-auto">
                        <div class="home-photo-placeholder"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-panel home-panel-hero d-flex align-items-center">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 col-lg-7 mb-5 mb-lg-0">
                    <h1 class="display-3 font-weight-bold mb-5">Mes services</h1>

                    <div class="mb-5">
                        <h2 class="h2 font-weight-bold">Création de site web</h2>
                        <p class="lead mb-0">
                            Un site pensé pour présenter ton activité avec une vraie personnalité, une structure claire et une base évolutive.
                        </p>
                    </div>

                    <div class="mb-4">
                        <h2 class="h2 font-weight-bold">Consulting en accessibilité</h2>
                        <p class="lead mb-0">
                            Une analyse concrète de ton site ou de ton application pour améliorer l'expérience réelle des utilisateurs.
                        </p>
                    </div>

                    <a class="home-plus-link mt-3 d-inline-flex align-items-center" href="{{ path('app_services') }}">
                        <span>Plus d'info</span>
                        <span class="home-plus-arrow" aria-hidden="true"></span>
                    </a>
                </div>

                <div class="col-12 col-lg-5 text-center">
                    <div class="home-photo-shell mx-auto">
                        <div class="home-photo-placeholder"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-panel home-panel-clients d-flex align-items-center">
        <div class="container">
            <h2 class="display-3 font-weight-bold text-center mb-5">Ils m'ont fait confiance</h2>

            <div class="row">
                <div class="col-12 col-lg-6 mb-5 mb-lg-0">
                    <div class="client-logo-wrap client-logo-wrap-home mb-4">
                        <img
                            class="client-logo"
                            src="{{ asset('images/clients/le-phare.png') }}"
                            alt="Logo de IDS le Phare"
                            loading="lazy"
                            decoding="async"
                        >
                    </div>
                    <h3 class="h2 font-weight-bold">IDS le Phare</h3>
                    <p class="mb-3">
                        Ils m'ont demandé de consulter l'accessibilité de leur nouveau site pour une ludothèque, avec des fonctionnalités d'emprunt de jeux de société et de livres en ligne.
                    </p>
                    <p class="font-weight-bold mb-0">Consulting en accessibilité web</p>
                        <a class="home-plus-link mt-4 d-inline-flex align-items-center" href="javascript:void(0)">
                            <span>Plus d'info</span>
                            <span class="home-plus-arrow" aria-hidden="true"></span>
                        </a>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="client-logo-wrap client-logo-wrap-home mb-4">
                        <img
                            class="client-logo"
                            src="{{ asset('images/clients/christophe-kippelen.png') }}"
                            alt="Logo de Christophe Kippelen"
                            loading="lazy"
                            decoding="async"
                        >
                    </div>
                    <h3 class="h2 font-weight-bold">Christophe Kippelen</h3>
                    <p class="mb-3">
                        Création d'un site WordPress avec une page d'accueil et une page de contact.
                    </p>
                    <p class="font-weight-bold mb-0">Site WordPress</p>
                        <a class="home-plus-link mt-4 d-inline-flex align-items-center" href="javascript:void(0)">
                            <span>Plus d'info</span>
                            <span class="home-plus-arrow" aria-hidden="true"></span>
                        </a>
                </div>
            </div>

            <div class="text-center mt-5">
                <a class="home-plus-link d-inline-flex align-items-center" href="{{ path('app_clients') }}">
                    <span>Plus d'info</span>
                    <span class="home-plus-arrow" aria-hidden="true"></span>
                </a>
            </div>
        </div>
    </section>

    <section class="home-panel home-panel-contact d-flex align-items-center" id="contact">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-9 home-contact-block">
                    <p class="text-uppercase font-weight-bold mb-3 home-kicker text-center">Parlons de votre projet</p>
                    <h2 class="display-4 font-weight-bold text-center mb-4">Me contacter</h2>
                    <p class="lead text-center mb-5">
                        Si vous avez une idée, un besoin de refonte, un site à rendre plus accessible ou simplement une question, vous pouvez m'envoyer un message directement ici.
                    </p>

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success" role="alert">{{ message }}</div>
                    {% endfor %}

                    {{ form_start(contactForm) }}
                        <div class="form-row">
                            <div class="form-group col-md-6">{{ form_row(contactForm.firstName) }}</div>
                            <div class="form-group col-md-6">{{ form_row(contactForm.name) }}</div>
                            <div class="form-group col-md-6">{{ form_row(contactForm.companyName) }}</div>
                            <div class="form-group col-md-6">{{ form_row(contactForm.emailAddress) }}</div>
                        </div>
                        <div class="form-group">{{ form_row(contactForm.subject) }}</div>
                        <div class="form-group">{{ form_row(contactForm.Content) }}</div>
                        <div class="form-group home-form-checkbox">{{ form_row(contactForm.RGPD) }}</div>

                        <button type="submit" class="btn btn-light">Envoyer</button>
                    {{ form_end(contactForm) }}
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
