{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container py-5">
    <header class="text-left my-4">
        <h1 class="display-4 mb-2">Matthieu THUET</h1>
        <h2 class="h2 mb-3">Je me présente</h2>
        <p class="lead mb-4">
            Je m'appelle Matthieu, j'ai 24 ans et je suis passionné par le développement web depuis plusieurs années. Depuis le 15 avril 2025, j'ai créé ma micro-entreprise afin de proposer mes services aux particuliers comme aux entreprises.
        </p>
        <a class="btn btn-primary" href="{{ path('app_about') }}">En apprendre plus</a>
    </header>

    <section class="my-5" id="services">
        <h2 class="h3 mb-4">Mes services</h2>

        <div class="row">
            <div class="col-12 col-md-6 mb-4" id="service-creation-site">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5 card-title">Création de site web sur mesure</h3>
                        <p class="card-text flex-grow-1">
                            Vous êtes un particulier ou une entreprise et vous souhaitez créer un site web pour mettre en avant votre activité (ou tout autre projet) ? Je vous accompagne de l'idée à la mise en ligne avec un site sur mesure, clair, moderne et évolutif.
                        </p>
                        <a class="btn btn-primary align-self-start" href="{{ path('app_services') }}#service-creation-site">Découvrir</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-4" id="service-accessibilite">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5 card-title">Consulting en accessibilité de site web et application mobile</h3>
                        <p class="card-text flex-grow-1">
                            Je vous propose d'analyser votre site web ou votre application afin de la rendre plus accessible à tous les handicaps, avec une spécialisation pour le handicap visuel. Étant moi-même déficient visuel, je suis particulièrement sensible à ce sujet et je suis prêt à vous accompagner pour améliorer durablement votre site web ou votre application mobile.
                        </p>
                        <a class="btn btn-primary align-self-start" href="{{ path('app_services') }}#service-accessibilite">Découvrir</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="my-5">
        <h2 class="h3 mb-4">Ils m'ont fait confiance</h2>

        {% include '_partials/clients_grid.html.twig' with {
            clients: clients|slice(0, 3),
            columns_md: 4,
            show_description: false,
            show_recommendation: false
        } %}

        <div class="d-flex justify-content-center mt-2">
            <a class="btn btn-primary" href="{{ path('app_clients') }}">Voir tout</a>
        </div>
    </section>
</div>
{% endblock %}
