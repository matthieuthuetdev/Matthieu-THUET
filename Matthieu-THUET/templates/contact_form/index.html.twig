{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<main class="page-panel page-panel-contact py-5">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 home-contact-block">
                <h1 class="display-4 font-weight-bold text-center mb-4">Me contacter</h1>
                <p class="lead text-center mb-5">
                    Si vous avez une idée, un besoin de refonte, un site à rendre plus accessible ou simplement une question, vous pouvez m'envoyer un message directement ici.
                </p>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success" role="alert">{{ message }}</div>
                {% endfor %}

                <p class="home-form-note">Les champs obligatoires sont symbolisés par une *</p>

                {{ form_start(contactForm) }}
                    <div class="form-row">
                        <div class="form-group col-md-6">{{ form_row(contactForm.firstName) }}</div>
                        <div class="form-group col-md-6">{{ form_row(contactForm.name) }}</div>
                        <div class="form-group col-md-6">{{ form_row(contactForm.companyName) }}</div>
                        <div class="form-group col-md-6">{{ form_row(contactForm.emailAddress) }}</div>
                    </div>
                    <div class="form-group">{{ form_row(contactForm.subject) }}</div>
                    <div class="form-group">{{ form_row(contactForm.Content) }}</div>
                    <div class="form-group home-form-checkbox">{{ form_row(contactForm.RGPD) }}</div>

                    <button type="submit" class="btn btn-light">Envoyer</button>
                {{ form_end(contactForm) }}
            </div>
        </div>
    </div>
</main>
{% endblock %}
