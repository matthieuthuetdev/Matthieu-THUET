{% extends 'base.html.twig' %}

{% block title %}Demande - Création de site web{% endblock %}

{% block body %}
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
      <h1 class="text-start mb-4">Demande - Création de site web</h1>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
      {% endfor %}

      {{ form_start(webCreationRequestForm) }}
        {{ form_widget(webCreationRequestForm) }}
        <button type="submit" class="btn btn-primary mt-3">Envoyer</button>
      {{ form_end(webCreationRequestForm) }}
    </div>
  </div>
</div>
{% endblock %}

