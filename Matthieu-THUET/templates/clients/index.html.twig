{% extends 'base.html.twig' %}

{% block title %}Mes clients{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="h2 mb-3">Mes clients</h1>

    <p class="lead mb-5">
        Déjà <strong>2</strong> clients m'ont fait confiance !<br>
        Faites une demande de mes services sur le site ou à l'adresse mail en bas de page afin de faire partie de mes clients.<br>
        J’aurai un immense plaisir à vous accompagner dans votre projet de création de site web ou dans l’amélioration de l’accessibilité de votre site web ou de votre application mobile !
    </p>

    <section class="my-5">
        <h2 class="h3 mb-4">Ils m'ont fait confiance</h2>

        <div class="row">
            <div class="col-12 col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="client-logo-wrap mb-3">
                            <img
                                class="client-logo"
                                src="{{ asset('images/clients/le-phare.png') }}"
                                alt="Logo de IDS le Phare"
                                loading="lazy"
                                decoding="async"
                            >
                        </div>
                        <h3 class="h5 card-title mb-2">IDS le Phare</h3>
                        <p class="card-text flex-grow-1">
                            Ils m'ont demandé de consulter l'accessibilité de leur nouveau site pour une ludothèque, avec des fonctionnalités d'emprunt de jeux de société et de livres en ligne.
                        </p>
                        <strong class="d-block mb-0">Consulting en accessibilité web</strong>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="client-logo-wrap mb-3">
                            <img
                                class="client-logo"
                                src="{{ asset('images/clients/christophe-kippelen.png') }}"
                                alt="Logo de Christophe Kippelen"
                                loading="lazy"
                                decoding="async"
                            >
                        </div>
                        <h3 class="h5 card-title mb-2">Christophe Kippelen</h3>
                        <p class="card-text flex-grow-1">
                            Création d’un site WordPress avec une page d’accueil et une page de contact.
                        </p>
                        <strong class="d-block mb-0">Site WordPress</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
